# ── Database (PostgreSQL — required) ──────────────────────────────
# Vercel + serverless cannot use the old local SQLite file. Create a free
# Postgres at https://neon.tech (or Supabase) and paste its connection string.
# Neon gives something like:
#   postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/madras?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/madras?sslmode=require"

# ── Auth (NextAuth v5) ────────────────────────────────────────────
# Generate a fresh one:  openssl rand -base64 32
AUTH_SECRET="change-me-openssl-rand-base64-32"
# Production URL of the deployed app (needed for OAuth callbacks + links)
AUTH_URL="https://your-app.vercel.app"
AUTH_TRUST_HOST="true"

# ── Google OAuth (optional — enables the "Continue with Google" button) ─
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Cron / scheduled forecast refresh ─────────────────────────────
# Set a long random string; Vercel Cron (vercel.json) sends it as ?key=...
# Generate:  openssl rand -hex 32
CRON_SECRET="change-me-openssl-rand-hex-32"

# ── Weather API (optional overrides — defaults work out of the box) ────
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
# INGEST_RAW_DIR="data/raw"
