{
  "name": "madras",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "clean": "pkill -f '[n]ext-server' 2>/dev/null; pkill -f '[n]ext start' 2>/dev/null; node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "clean:start": "npm run clean && npm run build && npm run start",
    "ingest": "tsx src/scripts/ingest.ts",
    "zones:validate": "tsx src/scripts/sync-zones.ts --validate",
    "zones:sync": "tsx src/scripts/sync-zones.ts",
    "process": "tsx src/scripts/process.ts",
    "load": "tsx src/scripts/load.ts",
    "test": "node --import tsx --test src/lib/processing/normalize.test.ts src/lib/processing/csv.test.ts src/lib/processing/pipeline.test.ts src/lib/processing/load.test.ts",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
        "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
